generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

model Organization {
  id           String         @id @default(cuid())
  name         String
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  Conversation Conversation[]
  followUps    FollowUp[]
  leads        Lead[]
  Message      Message[]
  properties   Property[]
  SiteVisit    SiteVisit[]
}

model Property {
  id             String       @id @default(cuid())
  organizationId String
  name           String
  location       String
  type           String
  bhk            Int
  price          Decimal      @db.Decimal(15, 2)
  status         String       @default("available")
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  SiteVisit      SiteVisit[]

  @@index([organizationId])
  @@index([organizationId, location])
  @@index([organizationId, bhk])
  @@index([organizationId, status])
}

model Customer {
  id             String         @id @default(cuid())
  organizationId String
  name           String?
  phone          String?
  email          String?
  language       String?
  source         String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  location       String?
  budget         Decimal?       @db.Decimal(15, 2)
  bhk            Int?
  propertyType   String?
  Conversation   Conversation[]
  followUps      FollowUp[]
  leads          Lead[]
  SiteVisit      SiteVisit[]

  @@unique([organizationId, phone])
  @@index([organizationId])
  @@index([organizationId, email])
}

model Lead {
  id             String       @id @default(cuid())
  organizationId String
  customerId     String
  status         String       @default("new")
  budget         Decimal?     @db.Decimal(15, 2)
  location       String?
  bhk            Int?
  propertyType   String?
  source         String?
  notes          String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  followUps      FollowUp[]
  customer       Customer     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  SiteVisit      SiteVisit[]

  @@index([organizationId])
  @@index([organizationId, status])
  @@index([organizationId, customerId])
  @@index([customerId], map: "Lead_customerId_fkey")
}

model FollowUp {
  id                 String       @id @default(cuid())
  organizationId     String
  leadId             String
  customerId         String
  channel            String       @default("whatsapp")
  action             String       @default("message")
  message            String?      @db.Text
  scheduledAt        DateTime
  status             String       @default("scheduled")
  attempts           Int          @default(0)
  cancellationReason String?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
  customer           Customer     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  lead               Lead         @relation(fields: [leadId], references: [id], onDelete: Cascade)
  organization       Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([organizationId, scheduledAt])
  @@index([organizationId, status])
  @@index([leadId])
  @@index([customerId])
}

model Conversation {
  id             String       @id
  organizationId String
  customerId     String?
  channel        String
  externalId     String?
  status         String       @default("active")
  createdAt      DateTime     @default(now())
  updatedAt      DateTime
  Customer       Customer?    @relation(fields: [customerId], references: [id])
  Organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  Message        Message[]

  @@unique([organizationId, channel, externalId])
  @@index([customerId], map: "Conversation_customerId_fkey")
  @@index([organizationId, channel])
  @@index([organizationId, customerId])
  @@index([organizationId])
}

model Message {
  id             String       @id
  organizationId String
  conversationId String
  role           String
  content        String       @db.Text
  externalId     String?
  metadata       Json?
  createdAt      DateTime     @default(now())
  Conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  Organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@index([organizationId, conversationId])
  @@index([organizationId])
}

model SiteVisit {
  id             String       @id
  organizationId String
  leadId         String
  customerId     String
  propertyId     String
  scheduledAt    DateTime
  status         String       @default("scheduled")
  notes          String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime
  Customer       Customer     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  Lead           Lead         @relation(fields: [leadId], references: [id], onDelete: Cascade)
  Organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  Property       Property     @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@index([leadId])
  @@index([organizationId])
  @@index([organizationId, scheduledAt])
  @@index([organizationId, status])
  @@index([propertyId])
}
